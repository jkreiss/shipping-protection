# Copy to shopify.app.staging.toml after creating a distinct staging Shopify app.
# Never reuse the production client_id, app URL, or database.
client_id = "REPLACE_WITH_STAGING_APP_CLIENT_ID"
name = "insurance-staging"
application_url = "https://REPLACE_WITH_STAGING_HOST"
embedded = true

[build]
automatically_update_urls_on_dev = false
include_config_on_deploy = true

[webhooks]
api_version = "2026-07"

  [[webhooks.subscriptions]]
  uri = "/webhooks/privacy"
  compliance_topics = [ "customers/data_request", "customers/redact", "shop/redact" ]
  [[webhooks.subscriptions]]
  uri = "/webhooks/app/scopes_update"
  topics = [ "app/scopes_update" ]
  [[webhooks.subscriptions]]
  uri = "/webhooks/app/uninstalled"
  topics = [ "app/uninstalled" ]
  [[webhooks.subscriptions]]
  uri = "/webhooks/orders/create"
  topics = [ "orders/create" ]
  [[webhooks.subscriptions]]
  uri = "/webhooks/orders/paid"
  topics = [ "orders/paid" ]
  [[webhooks.subscriptions]]
  uri = "/webhooks/orders/cancelled"
  topics = [ "orders/cancelled" ]
  [[webhooks.subscriptions]]
  uri = "/webhooks/orders/updated"
  topics = [ "orders/updated" ]
  [[webhooks.subscriptions]]
  uri = "/webhooks/refunds/create"
  topics = [ "refunds/create" ]

[access_scopes]
scopes = "write_products,read_orders,write_publications,write_cart_transforms"

[auth]
redirect_urls = [ "https://REPLACE_WITH_STAGING_HOST/auth/callback" ]

[shop.metafields.app.shipping_protection_config]
type = "json"
name = "Shipping protection configuration"
description = "Checkout-only shipping protection product and pricing contract"

[shop.metafields.app.shipping_protection_offer]
type = "json"
name = "Shipping protection checkout offer"
description = "Per-store selection preference and customer-facing checkout text"
