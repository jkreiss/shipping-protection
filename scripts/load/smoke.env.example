# Copy to the ignored .env.load-smoke file at the repository root.
APP_ENV=load
LOAD_SMOKE_CONFIRM=load-only
LOAD_SUPABASE_PROJECT_REF=<YOUR_LOAD_SUPABASE_PROJECT_REF>
DATABASE_URL=postgresql://postgres.<YOUR_LOAD_SUPABASE_PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?schema=public&sslmode=require&connection_limit=1
SHOPIFY_APP_URL=https://<YOUR_LOAD_WEB_PUBLIC_DOMAIN>
SHOPIFY_API_SECRET=load-dummy-secret
SCOPES=write_products,read_orders,write_publications,write_cart_transforms
