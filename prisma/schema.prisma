generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopInstallationState {
  INSTALLED
  UNINSTALLED
}

enum PricingRuleState {
  PENDING
  ACTIVE
  FAILED
  SUPERSEDED
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ProtectionAttributionStatus {
  ATTRIBUTED
  UNATTRIBUTED
}

enum ProtectionAttachmentStrategy {
  NONE
  CHECKOUT_UI_CART_TRANSFORM
  THEME_CART
}

enum PricingBasis {
  SHIPPABLE_PRE_DISCOUNT
}

enum ProtectionRefundStatus {
  PENDING
  CONFIRMED
  UNATTRIBUTED
}

enum ClaimType {
  LOST
  STOLEN
  DAMAGED
}

enum ClaimStatus {
  SUBMITTED
  VALIDATING
  AUTO_APPROVED
  REVIEW_REQUIRED
  MERCHANT_APPROVED
  MERCHANT_REJECTED
  RESOLUTION_PENDING
  RESOLVED
}

enum ClaimEventType {
  SUBMITTED
  VALIDATION_COMPLETED
  AUTO_APPROVED
  REVIEW_REQUESTED
  MERCHANT_APPROVED
  MERCHANT_REJECTED
  RESOLUTION_REQUESTED
  RESOLVED
}

model Shop {
  id                        String                @id @default(cuid())
  shopDomain                String                @unique
  shopGid                   String?               @unique
  installationState         ShopInstallationState @default(INSTALLED)
  activePricingRuleId       String?
  activePricingRuleShopId   String?
  installedAt               DateTime              @default(now())
  uninstalledAt             DateTime?
  orderReconciliationSince  DateTime?
  orderHistoryStartAt       DateTime?
  orderReconciliationCursor String?
  orderReconciliationUntil  DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  activePricingRule PricingRule?      @relation("ActivePricingRule", fields: [activePricingRuleId, activePricingRuleShopId], references: [id, shopId], onDelete: SetNull)
  pricingRules      PricingRule[]     @relation("ShopPricingRules")
  sessions          Session[]
  webhookDeliveries WebhookDelivery[]
  orders            Order[]
  configuration     ShopConfiguration?
  purchases         ProtectionPurchase[]
  claims            Claim[]
  claimEvents       ClaimEvent[]

  @@unique([activePricingRuleId, activePricingRuleShopId])
}

model ShopConfiguration {
  shopId             String @id
  protectionEnabled  Boolean @default(false)
  stolenCoverageEnabled Boolean @default(false)
  lostCoverageEnabled Boolean @default(false)
  damagedCoverageEnabled Boolean @default(false)
  returnsEnabled     Boolean @default(false)
  freeReturnsEnabled Boolean @default(false)
  attachmentStrategy ProtectionAttachmentStrategy @default(NONE)
  emailClaimIntakeEnabled Boolean @default(false)
  formClaimIntakeEnabled Boolean @default(false)
  adminClaimIntakeEnabled Boolean @default(false)
  autoApprovalEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model PricingRule {
  id              String           @id @default(cuid())
  shopId          String
  ruleId          String
  version         Int
  productId       String
  variantId       String
  rateBasisPoints Int
  basis           PricingBasis
  state           PricingRuleState @default(PENDING)
  effectiveAt     DateTime
  publishedAt     DateTime?
  activatedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  shop      Shop                 @relation("ShopPricingRules", fields: [shopId], references: [id], onDelete: Cascade)
  activeFor Shop?                @relation("ActivePricingRule")
  purchases ProtectionPurchase[]

  @@unique([shopId, version])
  @@unique([shopId, ruleId])
  @@unique([id, shopId])
  @@index([shopId, state])
}

model WebhookDelivery {
  id           String                  @id @default(cuid())
  shopId       String
  webhookId    String
  eventId      String?
  topic        String
  shopifyOrderId String
  status       WebhookProcessingStatus @default(PENDING)
  attempts     Int                     @default(0)
  nextAttemptAt DateTime               @default(now())
  leaseToken   String?
  leaseUntil   DateTime?
  errorMessage String?
  receivedAt   DateTime                @default(now())
  processedAt  DateTime?
  failedAt     DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, webhookId])
  @@index([shopId, eventId])
  @@index([shopId, topic, status])
  @@index([status, nextAttemptAt, leaseUntil])
}

model Order {
  id                   String    @id @default(cuid())
  shopId               String
  shopifyOrderId       String
  name                 String
  checkoutTokenHash    String?
  shopifyCreatedAt     DateTime
  shopifyUpdatedAt     DateTime
  processedAt          DateTime?
  isTest               Boolean   @default(false)
  cancelledAt          DateTime?
  financialStatus      String?
  firstPaidAt          DateTime?
  paidEligible         Boolean   @default(false)
  paidProtected        Boolean   @default(false)
  paidProtectionFee    Decimal   @default(0) @db.Decimal(20, 4)
  paidProtectionLineIds String[] @default([])
  paidMerchandiseAmount Decimal? @db.Decimal(20, 4)
  currencyCode         String
  subtotalAmount       Decimal   @db.Decimal(20, 4)
  totalAmount          Decimal   @db.Decimal(20, 4)
  totalDiscountsAmount Decimal   @db.Decimal(20, 4)
  totalShippingAmount  Decimal   @db.Decimal(20, 4)
  totalTaxAmount       Decimal   @db.Decimal(20, 4)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lines              OrderLine[]
  protectionPurchase ProtectionPurchase?
  protectionRefunds  ProtectionRefund[]

  @@unique([shopId, shopifyOrderId])
  @@unique([id, shopId])
  @@index([shopId, shopifyUpdatedAt, shopifyOrderId])
  @@index([shopId, firstPaidAt])
}

model ProtectionRefund {
  id              String   @id @default(cuid())
  shopId          String
  orderId         String
  shopifyRefundId String
  status          ProtectionRefundStatus
  amount          Decimal  @default(0) @db.Decimal(20, 4)
  currencyCode    String
  succeededAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([shopId, shopifyRefundId])
  @@index([shopId, orderId])
  @@index([shopId, status])
}

model OrderLine {
  id                  String   @id @default(cuid())
  shopId              String
  orderId             String
  shopifyLineItemId   String
  productId           String?
  variantId           String?
  quantity            Int
  requiresShipping    Boolean
  currencyCode        String
  originalUnitAmount  Decimal  @db.Decimal(20, 4)
  preDiscountAmount   Decimal  @db.Decimal(20, 4)
  totalDiscountAmount Decimal  @db.Decimal(20, 4)
  finalAmount         Decimal  @db.Decimal(20, 4)
  isProtection        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([shopId, orderId, shopifyLineItemId])
  @@index([shopId, orderId, isProtection])
}

model ProtectionPurchase {
  id                     String                      @id @default(cuid())
  orderId                String
  shopId                 String
  pricingRuleId          String?
  ruleId                 String?
  ruleVersion            Int?
  rateBasisPoints        Int?
  basis                  String?
  currencyCode           String
  eligibleSubtotalAmount Decimal?                    @db.Decimal(20, 4)
  coveredMerchandiseAmount Decimal?                   @db.Decimal(20, 4)
  orderValueAmount       Decimal?                     @db.Decimal(20, 4)
  feeAmount              Decimal                     @db.Decimal(20, 4)
  protectionLineIds      String[]                    @default([])
  pricingContractVersion Int?
  purchasedAt            DateTime?
  attributionStatus      ProtectionAttributionStatus
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  order       Order        @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  pricingRule PricingRule? @relation(fields: [pricingRuleId, shopId], references: [id, shopId], onDelete: NoAction)
  claims      Claim[]

  @@unique([shopId, id])
  @@unique([orderId, shopId])
  @@index([shopId, pricingRuleId])
  @@index([shopId, attributionStatus])
}

model Claim {
  id                   String      @id @default(cuid())
  shopId               String
  protectionPurchaseId String
  type                 ClaimType
  status               ClaimStatus @default(SUBMITTED)
  description          String?
  submittedAt          DateTime    @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  protectionPurchase ProtectionPurchase @relation(fields: [shopId, protectionPurchaseId], references: [shopId, id], onDelete: Cascade)
  events             ClaimEvent[]

  @@unique([shopId, id])
  @@index([shopId, status, submittedAt])
  @@index([shopId, protectionPurchaseId])
}

model ClaimEvent {
  id        String         @id @default(cuid())
  shopId    String
  claimId   String
  type      ClaimEventType
  actorRef  String?
  reason    String?
  createdAt DateTime       @default(now())

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  claim Claim @relation(fields: [shopId, claimId], references: [shopId, id], onDelete: Cascade)

  @@index([shopId, claimId, createdAt, id])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  shopRecord Shop @relation(fields: [shop], references: [shopDomain], onDelete: Cascade)

  @@index([shop])
}
