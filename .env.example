# Copy the Session pooler URL from Supabase Connect; add schema=public and sslmode=require.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:5432/postgres?schema=public&sslmode=require"
CHECKOUT_TOKEN_HASH_SECRET="replace-with-a-dedicated-random-secret"
SHOPIFY_APP_URL="https://<domain>"
SHOPIFY_API_KEY="shopify-client-id"
SHOPIFY_API_SECRET="shopify-shop-secret"
SCOPES="project-scopes"
NODE_ENV=production

# optional
PORT="0000"
SHOP_CUSTOM_DOMAIN="https://<custom-domain>"

