# Copy this file to .env for local development. Never put real secrets here.
# Supabase Connect > Session pooler (port 5432); URL-encode the password.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:5432/postgres?schema=public&sslmode=require"
CHECKOUT_TOKEN_HASH_SECRET="replace-with-a-dedicated-random-secret"

# Shopify CLI supplies these during `npm run dev`. Set real values in Railway
# Variables when hosting the app, using the same Shopify app as the TOML config.
# SHOPIFY_APP_URL="https://your-app.up.railway.app"
# SHOPIFY_API_KEY="your-shopify-client-id"
# SHOPIFY_API_SECRET="your-shopify-client-secret"
# SCOPES="write_products,write_metaobjects,write_metaobject_definitions,read_orders,write_publications,write_cart_transforms"
# NODE_ENV=production

# Optional: a custom Shopify shop domain, not the Railway app domain.
# SHOP_CUSTOM_DOMAIN="shop.example.com"
# If you manually set the Railway domain target to 3000 before deploying,
# set PORT=3000 in that Railway service's Variables so both ports match.
