{
  "name": "insurance",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "web:dev": "react-router dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "worker": "node scripts/worker.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "verify:postgres": "node scripts/verify-postgres.js",
    "verify:webhook-postgres": "node scripts/verify-webhook-postgres.js",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env.e2e node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "test:e2e:list": "playwright test --list",
    "test:e2e:auth": "node --env-file-if-exists=.env.e2e e2e/auth.js",
    "test:e2e:fixtures": "node --env-file-if-exists=.env.e2e e2e/setup-fixtures.js",
    "test:e2e:restore": "node --env-file-if-exists=.env.e2e e2e/restore.js",
    "test:e2e:report": "playwright show-report .playwright/report",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "lint": "eslint --ignore-path .eslintignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && CI=true shopify app function typegen --path extensions/shipping-protection-transform --no-color && tsc --noEmit && tsc --noEmit --project extensions/insurance-ext/tsconfig.json && tsc --noEmit --project extensions/shipping-protection-transform/tsconfig.json && npm run typecheck:e2e"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@sentry/node": "11.1.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/cli": "3.90.0",
    "@shopify/polaris-types": "^1.0.1",
    "@shopify/ui-extensions-tester": "2026.7.0",
    "@testing-library/preact": "^3.2.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "jasonkreiss"
}
