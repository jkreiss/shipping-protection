# Copy to .env.e2e. Only the E2E_* values are used; application .env is never read.
E2E_SHOP_DOMAIN=app-test-kwvgodpl.myshopify.com
# Optional: copy the installed app URL from Shopify Admin if this default redirects.
E2E_ADMIN_APP_URL=https://admin.shopify.com/store/app-test-kwvgodpl/apps/2023a5496c2a665db70327c68082fa04
# Dedicated SELECT-only staging database login, without access to Session.
E2E_DATABASE_URL=
# Numeric VARIANT IDs, not product IDs. Prices in the shop currency: 100 and 40.
E2E_PHYSICAL_VARIANT_ID=
E2E_DIGITAL_VARIANT_ID=
# 10% off the physical fixture only; never discount the protection product.
E2E_DISCOUNT_CODE=E2E10
# bogus OR shopify-payments; keep the chosen gateway in test mode.
E2E_PAYMENT_GATEWAY=bogus
E2E_SHIPPING_COUNTRY=US
# Optional for a password-protected staging storefront.
E2E_STOREFRONT_PASSWORD=
